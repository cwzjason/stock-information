# 复制为 backend/.env 后填入真实值；.env 已在 .gitignore 中，不会提交到 GitHub
# 云端（GitHub Actions）不需要这个文件，用仓库 Settings -> Secrets 配置同名变量即可

WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=你的key

# Supabase：Dashboard -> Project Settings -> API
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_KEY=你的anon或service_role key
